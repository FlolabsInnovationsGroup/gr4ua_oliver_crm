{
  "kind": "collectionType",
  "collectionName": "section_contents",
  "info": {
    "singularName": "section-content",
    "pluralName": "section-contents",
    "displayName": "Section Content",
    "description": "Reusable content blocks for various sections"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "identifier": {
      "type": "uid",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "content": {
      "type": "richtext",
      "required": true
    },
    "subtitle": {
      "type": "string"
    },
    "ctaText": {
      "type": "string"
    },
    "ctaLink": {
      "type": "string"
    },
    "backgroundImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "SEO_Title": {
      "type": "string"
    },
    "SEO_Description": {
      "type": "text"
    },
    "SEO_Keywords": {
      "type": "string"
    },
    "Slug": {
      "type": "uid",
      "targetField": "title"
    }
  }
}
