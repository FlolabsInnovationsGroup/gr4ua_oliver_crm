{
  "kind": "collectionType",
  "collectionName": "internships",
  "info": {
    "singularName": "internship",
    "pluralName": "internships",
    "displayName": "Internship",
    "description": "Internship positions and opportunities"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "internship_status": {
      "type": "enumeration",
      "required": true,
      "default": "Open",
      "enum": [
        "Open",
        "Closed",
        "Filled"
      ]
    },
    "location": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "richtext",
      "required": true
    },
    "requirements": {
      "type": "richtext"
    },
    "responsibilities": {
      "type": "richtext"
    },
    "hubspotFormId": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "images": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "SEO_Title": {
      "type": "string"
    },
    "SEO_Description": {
      "type": "text"
    },
    "SEO_Keywords": {
      "type": "string"
    }
  }
}
