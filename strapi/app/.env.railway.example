# Server
HOST=0.0.0.0
PORT=1337

# Database (Railway will provide DATABASE_URL automatically)
DATABASE_CLIENT=postgres
DATABASE_URL=${DATABASE_URL}
DATABASE_SSL=false

# Secrets (Generate new ones for production!)
# You can generate new keys using: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=

# JWT
JWT_SECRET=

# Node environment
NODE_ENV=production
